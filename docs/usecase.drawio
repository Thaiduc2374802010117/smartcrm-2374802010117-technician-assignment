<mxfile host="app.diagrams.net"><diagram name="Use Case L4" id="d1"><mxGraphModel dx="1000" dy="895" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="895" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="Hệ thống: Phân công kỹ thuật viên và lịch hẹn (luồng L4)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#333333;fontSize=14;fontColor=#111111;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="30" width="600" height="710" as="geometry"/></mxCell><mxCell id="qltt" value="Quản lý trung tâm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="40" height="80" as="geometry"/></mxCell><mxCell id="ktv" value="Kỹ thuật viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="890" y="430" width="40" height="80" as="geometry"/></mxCell><mxCell id="uc1" value="UC1: Xem danh sách phiếu&lt;br&gt;chờ phân công" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="250" height="58" as="geometry"/></mxCell><mxCell id="uc3" value="UC3: Phân công kỹ thuật viên&lt;br&gt;cho phiếu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="190" width="250" height="58" as="geometry"/></mxCell><mxCell id="uc4" value="UC4: Đổi kỹ thuật viên&lt;br&gt;kèm lý do" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="300" width="250" height="58" as="geometry"/></mxCell><mxCell id="uc5" value="UC5: Đặt lịch hẹn&lt;br&gt;giao – nhận máy" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="410" width="250" height="58" as="geometry"/></mxCell><mxCell id="uc7" value="UC7: Xem bảng khối lượng&lt;br&gt;công việc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="520" width="250" height="58" as="geometry"/></mxCell><mxCell id="uc2" value="UC2: Xem gợi ý&lt;br&gt;kỹ thuật viên phù hợp" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="245" width="250" height="58" as="geometry"/></mxCell><mxCell id="uc6" value="UC6: Xem danh sách phiếu&lt;br&gt;được giao cho tôi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="440" width="250" height="58" as="geometry"/></mxCell><mxCell id="uc8" value="UC8: Xem lịch sử phiếu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="630" width="250" height="58" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Chú thích ký hiệu&lt;/b&gt;&lt;br&gt;Hình người: actor – vai trò dùng hệ thống, đặt NGOÀI ranh giới&lt;br&gt;Hình elip: use case – đặt tên ĐỘNG TỪ + ĐỐI TƯỢNG&lt;br&gt;Khung chữ nhật: ranh giới hệ thống luồng L4&lt;br&gt;Đường liền: actor thực hiện use case&lt;