<mxfile host="app.diagrams.net"><diagram name="Kien truc L4 - da hien thuc BT2" id="d1"><mxGraphModel dx="1180" dy="900" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="qltt" value="Quản lý trung tâm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="150" y="15" width="32" height="64" as="geometry"/></mxCell><mxCell id="ktv" value="Kỹ thuật viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="560" y="15" width="32" height="64" as="geometry"/></mxCell><mxCell id="pres" value="&lt;b&gt;① LỚP TRÌNH BÀY (Presentation)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="640" height="225" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Giao diện web – src/frontend/ (View), cổng 5500&lt;/b&gt;&lt;br&gt;3 màn hình M1 · M2 · M3 + đăng nhập; api/client.js là nơi DUY NHẤT gọi fetch; DataState đang tải · rỗng · lỗi.&lt;br&gt;KHÔNG chứa quy tắc nghiệp vụ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=11;fontColor=#111111;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="145" width="610" height="70" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API – src/backend/api/ (Controller), FastAPI cổng 3000, 16 endpoint E1–E16&lt;/b&gt;&lt;br&gt;Kiểm tra kiểu dữ liệu; kiểm tra quyền dùng chung auth.py (X-Employee-Id, X-Role, X-Center-Id – NFR4);&lt;br&gt;errors.py đổi lỗi nghiệp vụ thành 400/401/403/404/409/422, CSDL tắt → 503. KHÔNG truy vấn CSDL." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=11;fontColor=#111111;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="255" width="610" height="75" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;② LỚP NGHIỆP VỤ – src/backend/services/ – TOÀN BỘ quy tắc nghiệp vụ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#2F5597;fontSize=12;fontColor=#111111;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="395" width="640" height="150" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;AssignmentService&lt;/b&gt;&lt;br&gt;Gợi ý KTV (QT-08)&lt;br&gt;Phân công (QT-06,&lt;br&gt;QT-07, QT-L4-01)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="430" width="150" height="100" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;AppointmentService&lt;/b&gt;&lt;br&gt;Đặt, sửa giờ, hủy&lt;br&gt;lịch hẹn&lt;br&gt;(QT-L4-02 … 06)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="229" y="430" width="150" height="100" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;TicketQueryService&lt;/b&gt;&lt;br&gt;Danh sách phiếu&lt;br&gt;(US1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="386" y="430" width="150" height="100" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;TechnicianService&lt;/b&gt;&lt;br&gt;CRUD kỹ thuật viên&lt;br&gt;xoá mềm (QT-13)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="543" y="430" width="150" height="100" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;③ LỚP TRUY CẬP DỮ LIỆU – src/backend/repositories/ (psycopg 3)&lt;/b&gt;&lt;br&gt;TicketRepository · TechnicianRepository · AppointmentRepository · StatusLogRepository · UnitOfWork&lt;br&gt;SQL tham số hóa; giao dịch (UnitOfWork); UPDATE … WHERE status = &amp;#x27;MOI&amp;#x27; chống phân công trùng (NFR3).&lt;br&gt;KHÔNG chứa quy tắc nghiệp vụ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=11;fontColor=#111111;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="640" height="85" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;④ LỚP LƯU TRỮ – PostgreSQL 16 (db/migrations, db/seed)&lt;/b&gt;&lt;br&gt;ticket · technician · technician_skill · issue_category · appointment · ticket_status_log&lt;br&gt;Index cho NFR1, NFR2 · khóa ngoại, CHECK · ràng buộc EXCLUDE chống trùng lịch hẹn (QT-L4-02)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2F5597;fontSize=11;fontColor=#111111;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="640" height="90" as="geometry"/></mxCell><mxCell id="oos" value="&lt;b&gt;NGOÀI PHẠM VI / CHƯA LÀM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#F2F2F2;strokeColor=#888888;fontSize=12;fontColor=#555555;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="115" width="390" height="420" as="geometry"/></mxCell><mxCell id="o0" value="L2 – Tiếp nhận phiếu, phân loại,&lt;br&gt;sinh hạn cam kết (QT-04)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="155" width="350" height="56" as="geometry"/></mxCell><mxCell id="o1" value="L5 – Kho linh kiện · L8 – Khảo sát" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="221" width="350" height="44" as="geometry"/></mxCell><mxCell id="o2" value="Đăng nhập thật (W8) – đang giả lập" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="275" width="350" height="44" as="geometry"/></mxCell><mxCell id="o3" value="Gửi SMS / Zalo nhắc lịch hẹn" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="329" width="350" height="44" as="geometry"/></mxCell><mxCell id="o4" value="Cập nhật tiến độ sửa chữa (W4)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="383" width="350" height="44" as="geometry"/></mxCell><mxCell id="o5" value="E6 đổi KTV · E7 · E8 – hoãn (TD-09)&lt;br&gt;Docker – chưa làm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="437" width="350" height="56" as="geometry"/></mxCell><mxCell id="seed" value="Dataset Smart CRM (data/official/*.csv)&lt;br&gt;seed_dataset.py nạp 7.800 phiếu –&lt;br&gt;chạy lại không nhân đôi (C5)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="560" width="350" height="70" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Chú thích ký hiệu&lt;/b&gt;&lt;br&gt;Khung ①–④: bốn lớp – mỗi lớp là một thư mục mã&lt;br&gt;Khối xanh viền liền: đã hiện thực ở BT2&lt;br&gt;Khối xám viền đứt: ngoài phạm vi hoặc chưa làm&lt;br&gt;Mũi tên liền: phụ thuộc MỘT CHIỀU – lớp trên gọi&lt;br&gt;  lớp ngay dưới; không gọi ngược, không nhảy cóc&lt;br&gt;Mũi tên đứt: nạp dữ liệu mẫu" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#999999;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="665" width="390" height="165" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=open;html=1;strokeColor=#333333;fontSize=11;rounded=0;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="qltt" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=open;html=1;strokeColor=#333333;fontSize=11;rounded=0;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="ktv" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="HTTP + JSON (REST, CORS)" style="endArrow=open;html=1;strokeColor=#333333;fontSize=11;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="gọi hàm Python" style="endArrow=open;html=1;strokeColor=#333333;fontSize=11;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pres" target="svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="gọi qua UnitOfWork / Repository" style="endArrow=open;html=1;strokeColor=#333333;fontSize=11;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc" target="repo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="SQL qua TCP cổng 5432" style="endArrow=open;html=1;strokeColor=#333333;fontSize=11;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="repo" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="endArrow=open;html=1;strokeColor=#333333;fontSize=11;rounded=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="seed" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="595"/><mxPoint x="730" y="785"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>