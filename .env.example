# Sao chép:  cp .env.example .env   (Windows cmd: copy .env.example .env)
# KHÔNG commit .env. Các giá trị dưới đây là giá trị MẪU chạy được để thử – đổi hết khi triển khai thật.

# Máy chủ CSDL. Chạy bằng docker compose thì compose tự đặt = db; chạy trực tiếp trên máy thì localhost
DB_HOST=localhost
# Cổng CSDL
DB_PORT=5432
# Tên database
DB_NAME=smartcrm
# Tài khoản CSDL (docker compose dùng tài khoản này để tạo CSDL)
DB_USER=smartcrm
# Mật khẩu CSDL – ĐỔI khi triển khai thật
DB_PASSWORD=doi-mat-khau-nay
# Cổng API mở ra máy chủ (giao diện gọi http://localhost:3000 – đổi thì sửa src/frontend/api/config.js)
APP_PORT=3000
# Cổng giao diện web mở ra máy chủ
WEB_PORT=5500
# Địa chỉ giao diện được phép gọi API (CORS), cách nhau bằng dấu phẩy
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# Database riêng cho test tích hợp (tự tạo, không đụng dữ liệu chính)
TEST_DB_NAME=smartcrm_test
